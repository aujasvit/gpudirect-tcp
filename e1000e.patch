+// best-effort write
+void spsc_write(spsc_ring_t *ring, void __iomem **mmio_map_ring, const pkt_desc_t *desc)
+{
+	uint32_t head, tail, num_slots;
+	uint32_t next;
+
+	head = readl_relaxed(&ring->head);
+	tail = readl_relaxed(&ring->tail);
+	num_slots = readl_relaxed(&ring->num_slots);
+
+	next = (head + 1) % num_slots;
+	if (next == tail) {
+		pr_warn("spsc ring full, dropping write\n");
+		return;
+	}
+
+	memcpy_toio(mmio_map_ring[head], desc, sizeof(pkt_desc_t));
+
+	// head should not be updated before desc write completes
+	// also, dma_wmb() does not provide guarantees for mmio writes
+	wmb();
+
+	iowrite32(next, &ring->head);
+}
+
+int spsc_read_inject_batch(spsc_ring_t* inject_ring, pkt_desc_t *desc_array, int desc_array_sz)
+{
+	int count = desc_array_sz;
+	uint32_t head, tail, num_slots, slot_sz;
+	int ready_count;
+	int i;
+
+	head = gdr.inject_ring->head;
+	tail = gdr.inject_ring->tail;
+	num_slots = gdr.inject_ring->num_slots;
+	slot_sz = gdr.inject_ring->slot_sz;
+
+	ready_count = (head - tail + num_slots) % num_slots;
+	if (ready_count < count)
+		count = ready_count;
+
+	if (count == 0)
+		return 0;
+
+	for (i = 0; i < count; i++) {
+		desc_array[i] = *(pkt_desc_t*)(gdr.inject_ring->va2.kernel_va + slot_sz * tail);
+		if (desc_array[i].magic != GDR_MAGIC) {
+			// Using BUG() hangs the system, lets avoid that
+			for (;;) {
+				pr_alert("spsc_read_inject_batch invalid magic!\n");
+			}
+		}
+		tail = (tail + 1) % num_slots;
+	}
+
+	mb();
+
+	return count;
+}
+
+void spsc_read_inject_complete(spsc_ring_t* inject_ring, int count)
+{
+	uint32_t tail = gdr.inject_ring->tail;
+
+	tail = (tail + count) % gdr.inject_ring->num_slots;
+	gdr.inject_ring->tail = tail;
+}
+
+int enable_gdr(gdr_mem_setup_t mem_setup)
+{
+	uint32_t page_size;
+	int slots_per_page;
+	uint64_t gpu_va, dma_addr;
+	pmem_desc_t *desc;
+	int i, j;
+	uint32_t pmem_slot_sz;
+	bool to_break;
+	uint64_t rx_va_start, redirect_va_start, tx_va_start;
+	int rx_page_idx_start, redirect_page_idx_start, tx_page_idx_start;
+	// rx, redirect, tx
+	int pages_per_queue;
+
+	if (!(gdr.adapter->netdev->features & NETIF_F_RXCSUM)) {
+		pr_alert("NEIF_F_RXCSUM is not set in netdev->features; checksum offload must be enabled!\n");
+		return -1;
+	}
+
+	gdr.mem_setup = mem_setup;
+	gdr.alloc_idx = 0;
+
+	if (pin_and_map_gpu_mem(gdr.adapter->pdev, mem_setup.pmem_addr,
+				mem_setup.pmem_length, &gdr.pmem_page_table,
+				&gdr.pmem_dma_mapping) != 0)
+		return -1;
+	if (pin_and_map_gpu_mem(gdr.adapter->pdev, mem_setup.cmem_addr,
+				mem_setup.cmem_length, &gdr.cmem_page_table,
+				&gdr.cmem_dma_mapping) != 0)
+		return -1;
+
+	if (gdr.pmem_page_table->page_size != NVIDIA_P2P_PAGE_SIZE_64KB ||
+			gdr.cmem_page_table->page_size != NVIDIA_P2P_PAGE_SIZE_64KB) {
+		pr_alert("GPU page size not 64KB, exiting\n");
+		return -1;
+	}
+
+	page_size = (1 << 16);
+	pmem_slot_sz = 2048;
+	slots_per_page = page_size / pmem_slot_sz;
+
+	gdr.pmem_size = 0;
+	gpu_va = (uint64_t)mem_setup.pmem_addr;
+	to_break = false;
+	for (i = 0; i < gdr.pmem_page_table->entries; i++) {
+		dma_addr = gdr.pmem_dma_mapping->dma_addresses[i];
+		for (j = 0; j < slots_per_page; j++, gpu_va += pmem_slot_sz, dma_addr += pmem_slot_sz) {
+			if (gdr.pmem_size * sizeof(pmem_desc_t) == sizeof(gdr.pmem)) {
+				pr_alert("Allocated too much pmem memory!\n");
+				to_break = true;
+				break;
+			}
+
+			desc = &gdr.pmem[gdr.pmem_size++];
+			desc->space = pmem_slot_sz;
+			desc->is_free = true;
+			desc->dma_addr = dma_addr;
+			desc->gpu_va = gpu_va;
+		}
+		if (to_break)
+			break;
+	}
+	pr_info("pmem successfully allocated: gpu va start %llu, pmem size %lu, pmem entries %d\n", 
+			(u64)mem_setup.pmem_addr, mem_setup.pmem_length, gdr.pmem_size);
+
+	gdr.cmem_env_phys = (gpu_phys_t)gdr.cmem_page_table->pages[0]->physical_address;
+	gdr.cmem_env_mmio = ioremap((resource_size_t)gdr.cmem_env_phys, page_size);
+	if (gdr.cmem_env_mmio == NULL) {
+		pr_alert("ioremap failed while trying to map cmem config\n");
+		return -1;
+	}
+
+	gdr.rx_ring_mmio = (spsc_ring_t __iomem*)gdr.cmem_env_mmio;
+	gdr.redirect_ring_mmio = gdr.rx_ring_mmio + 1;
+	gdr.tx_ring_mmio = gdr.redirect_ring_mmio + 1;
+
+	pages_per_queue = (NUM_SLOTS * QUEUE_ENTRY_SZ) / GPU_PAGE_SIZE;
+	if (gdr.cmem_page_table->entries != (1 + 3 * pages_per_queue)) {
+		pr_alert("enable_gdr failed, page table entry count does not match with required pages_per_queue\n");
+		return -1;
+	}
+
+	rx_page_idx_start = 1;
+	redirect_page_idx_start = rx_page_idx_start + pages_per_queue;
+	tx_page_idx_start = redirect_page_idx_start + pages_per_queue;
+
+	rx_va_start = (u64)mem_setup.cmem_addr + page_size;
+	redirect_va_start = (u64)mem_setup.cmem_addr + redirect_page_idx_start * page_size;
+	tx_va_start = (u64)mem_setup.cmem_addr + tx_page_idx_start * page_size;
+
+	if (init_rx_ring(gdr.rx_ring_mmio, rx_va_start, QUEUE_ENTRY_SZ, gdr.cmem_page_table,
+				rx_page_idx_start, redirect_page_idx_start, &gdr.rx_ring_size, gdr.mmio_map_rx_ring,
+				sizeof(gdr.mmio_map_rx_ring) / sizeof(gdr.mmio_map_rx_ring[0])) < 0)
+		return -1;
+
+	if (init_redirect_ring(gdr.redirect_ring_mmio, redirect_va_start, QUEUE_ENTRY_SZ, 
+				gdr.cmem_page_table, redirect_page_idx_start, tx_page_idx_start,
+				&gdr.redirect_ring_size, gdr.phys_map_redirect_ring,
+				sizeof(gdr.phys_map_redirect_ring) / sizeof(gdr.phys_map_redirect_ring[0])) < 0)
+		return -1;
+
+	if (init_tx_ring(gdr.tx_ring_mmio, tx_va_start, QUEUE_ENTRY_SZ,
+				gdr.cmem_page_table, tx_page_idx_start, gdr.cmem_page_table->entries,
+				&gdr.tx_ring_size, gdr.phys_map_tx_ring,
+				sizeof(gdr.phys_map_tx_ring) / sizeof(gdr.phys_map_tx_ring[0])) < 0)
+		return -1;
+
+	if (gdr.rx_ring_size != NUM_SLOTS || gdr.redirect_ring_size != NUM_SLOTS
+		|| gdr.tx_ring_size != NUM_SLOTS) {
+		pr_alert("ring size not equal to NUM_SLOTS, failing!\n");
+		return -1;
+	}
+
+	gdr.inject_memory = vmalloc(IMEM_SZ);
+	if (!gdr.inject_memory) {
+		pr_alert("vmalloc failed to allocate inject memory\n");
+		return -1;
+	}
+	// inject ring is setup by kernel
+	gdr.inject_ring = (spsc_ring_t*)gdr.inject_memory;
+	gdr.inject_ring->userspace_va = NULL;
+	gdr.inject_ring->va2.kernel_va = CPU_PAGE_SIZE + (char*)gdr.inject_ring;
+	gdr.inject_ring->length_bytes = NUM_SLOTS * QUEUE_ENTRY_SZ;
+	gdr.inject_ring->head = 0;
+	gdr.inject_ring->tail = 0;
+	gdr.inject_ring->num_slots = NUM_SLOTS;
+	gdr.inject_ring->slot_sz = QUEUE_ENTRY_SZ;
+	gdr.inject_ring->magic = GDR_MAGIC;
+
+	pr_info("Taking e1000e down!\n");
+	e1000e_down(gdr.adapter, true); // hard reset to be on the safer side
+	gdr.enabled = true; // gg
+	e1000e_up(gdr.adapter);
+	pr_info("e1000e back up, gdr enabled successfully\n");
+
+	return 0;
+}
+
+void disable_gdr(void)
+{
+	if (!gdr.enabled)
+		return;
+
+	gdr.enabled = false;
+
+	vfree(gdr.inject_memory);
+
+	nvidia_p2p_dma_unmap_pages(gdr.adapter->pdev, gdr.pmem_page_table, gdr.pmem_dma_mapping);
+	nvidia_p2p_put_pages(0, 0, (u64)gdr.mem_setup.pmem_addr, gdr.pmem_page_table);
+
+	nvidia_p2p_dma_unmap_pages(gdr.adapter->pdev, gdr.cmem_page_table, gdr.cmem_dma_mapping);
+	nvidia_p2p_put_pages(0, 0, (u64)gdr.mem_setup.cmem_addr, gdr.cmem_page_table);
+
+	pr_info("disable_gdr: taking e1000e down\n");
+	e1000e_down(gdr.adapter, true);
+	e1000e_up(gdr.adapter);
+
+	pr_info("GDR disabled bye bye, normal rx path should work now\n");
+}
