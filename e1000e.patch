+int pin_and_map_gpu_mem(struct pci_dev *pdev, void* d_addr, size_t pin_size, nvidia_p2p_page_table_t** page_table,
+		nvidia_p2p_dma_mapping_t** dma_mapping)
+{
+	u64 virt_start;
+	int ret;
+	nvidia_p2p_page_table_t* pt_ptr;
+	nvidia_p2p_dma_mapping_t* dma_ptr;
+
+	virt_start = (u64)d_addr;
+	if (virt_start % GPU_BOUND_SIZE) {
+		pr_alert("pin_and_map_gpu_mem: gpu va not aligned to GPU_BOUND_SIZE\n");
+		return -1;
+	}
+	
+	if (pin_size % GPU_BOUND_SIZE) {
+		pr_alert("pin_and_map_gpu_mem: pin_size not aligned to GPU_BOUND_SIZE\n");
+	}
+
+	ret = nvidia_p2p_get_pages(0, 0, virt_start, pin_size, page_table, 
+			gpu_page_table_free_callback, *page_table);
+	if (ret != 0) {
+		pr_alert("failed to pin gpu memory, error code %d\n", ret);
+		return -1;
+	}
+
+	ret = nvidia_p2p_dma_map_pages(pdev, *page_table, dma_mapping);
+	if (ret != 0) {
+		pr_alert("failed to get dma mapping for gpu memory, error code %d\n", ret);
+		return -1;
+	}
+
+	pt_ptr = *page_table;
+	dma_ptr = *dma_mapping;
+	if (pt_ptr->entries != dma_ptr->entries) {
+		pr_alert("dma mapping entry count does not match page table entry count, wtf?\n");
+		return -1;
+	}
+
+	return 0;
+}
+
+// [start_idx, end_idx)
+int init_rx_ring(spsc_ring_t __iomem* rx_ring, uint64_t gpu_va_start, uint32_t slot_sz,
+		nvidia_p2p_page_table_t *page_table, int start_idx, 
+		int end_idx, int* size, void __iomem** mmio_map_ring, int mmio_map_ring_sz)
+{
+	uint32_t num_slots = 0;
+	void __iomem *cpu_va;
+	uint64_t page_size;
+	int i, j;
+	int slots_per_page;
+	bool to_break = false;
+
+	if (page_table->page_size != NVIDIA_P2P_PAGE_SIZE_64KB) 
+		return -1;
+
+	if (!is_power_of_2(slot_sz)) {
+		pr_alert("spsc ring slot size must be a power of 2!\n");
+		return -1;
+	}
+	
+	page_size = 1 << 16;
+	slots_per_page = page_size / slot_sz;
+	if (!slots_per_page)
+		return -1;
+
+	for (i = start_idx; i < end_idx; i++) {
+		cpu_va = ioremap(page_table->pages[i]->physical_address,
+				page_size);
+		if (cpu_va == NULL) {
+			pr_alert("init_rx_ring: ioremap failed!\n");
+			return -1;
+		}
+		for (j = 0; j < slots_per_page; j++, cpu_va += slot_sz) {
+			if (num_slots == mmio_map_ring_sz) {
+				pr_warn("init_rx_ring: info_ring_sz insufficient\n");
+				to_break = true;
+				break;
+			}
+			mmio_map_ring[num_slots++] = cpu_va;
+		}
+		if (to_break)
+		    break;
+	}
+
+	writeq(gpu_va_start, &rx_ring->gpu_va);
+	writeq(num_slots * slot_sz, &rx_ring->length_bytes);
+
+	iowrite32(0, &rx_ring->head);
+	iowrite32(0, &rx_ring->tail);
+	iowrite32(num_slots, &rx_ring->num_slots);
+	iowrite32(slot_sz, &rx_ring->slot_sz);
+
+	iowrite32(GDR_MAGIC, &rx_ring->magic);
+
+	wmb();
+
+	*size = num_slots;
+
+	return 0;
+}
+
