+int inject_packets(int count)
+{
+#define INJECT_BATCH_SZ 16
+	pkt_desc_t desc_array[INJECT_BATCH_SZ];
+	pkt_info_t *pkt_info;
+	pkt_desc_t *pkt_desc;
+	struct sk_buff *skb;
+	int ret;
+	int i;
+
+	if (INJECT_BATCH_SZ < count)
+		count = INJECT_BATCH_SZ;
+
+	ret = spsc_read_inject_batch(gdr.inject_ring, desc_array, count);
+	if (ret < count)
+		count = ret;
+
+	for (i = 0; i < count; i++) {
+		pkt_desc = &desc_array[i];
+		pkt_info = (pkt_info_t*)(pkt_desc->nic_info);
+		skb = __netdev_alloc_skb_ip_align(gdr.adapter->netdev, gdr.adapter->rx_buffer_len, GFP_ATOMIC);
+		skb_put(skb, pkt_desc->length);
+		memcpy(skb->data, gdr.inject_memory + pkt_desc->offset, pkt_desc->length);
+
+		e1000_rx_checksum(gdr.adapter, pkt_info->staterr, skb);
+		e1000_rx_hash(gdr.adapter->netdev, pkt_info->rx_desc.wb.lower.hi_dword.rss, skb);
+		e1000_receive_skb(gdr.adapter, gdr.adapter->netdev, skb,
+				pkt_info->staterr, pkt_info->rx_desc.wb.upper.vlan);
+	}
+
+	spsc_read_inject_complete(gdr.inject_ring, count);
+
+	return count;
+}
