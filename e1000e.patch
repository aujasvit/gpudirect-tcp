+// Cache coherency is likely not a problem for the inject ring
+static vm_fault_t chdev_inject_fault(struct vm_fault* vmf)
+{
+	struct vm_area_struct* vma = vmf->vma;
+	unsigned long offset;
+	struct page* page;
+
+	offset = vmf->address - vma->vm_start;
+	if (offset >= IMEM_SZ)
+		return VM_FAULT_SIGBUS;
+
+	page = vmalloc_to_page(gdr.inject_memory + offset);
+	if (!page) {
+		pr_alert("vmalloc_to_page failure despite valid offset??\n");
+		return VM_FAULT_SIGBUS;
+	}
+
+	get_page(page);
+	vmf->page = page;
+
+	return 0;
+}
+
+static const struct vm_operations_struct inject_vm_ops = {
+	.fault = chdev_inject_fault,
+};
+
+static int chdev_inject_release(struct inode* inode, struct file* file)
+{
+	atomic_dec(&chdev_inject.opened);
+	module_put(THIS_MODULE);
+	return 0;
