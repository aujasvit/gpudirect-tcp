+static int chdev_inject_mmap(struct file* filp, struct vm_area_struct* vma)
+{
+	unsigned long sz = vma->vm_end - vma->vm_start;
+	if (sz != IMEM_SZ)
+		return -EINVAL;
+
+	gdr.inject_ring->userspace_va = (void*)vma->vm_start + CPU_PAGE_SIZE;
+
+	vma->vm_ops = &inject_vm_ops;
+	return 0;
+}
+
+static int chdev_redirect_mmap(struct file* filp, struct vm_area_struct* vma)
+{
+	unsigned long userspace_addr = vma->vm_start;
+	unsigned long sz = vma->vm_end - vma->vm_start;
+	int num_slots = gdr.redirect_ring_size;
+	int slot_sz = ioread32(&gdr.redirect_ring_mmio->slot_sz);
+	int slots_per_page = CPU_PAGE_SIZE / slot_sz;
+	int i;
+
+	if (sz != (CPU_PAGE_SIZE + num_slots * slot_sz))
+		return -EINVAL;
+
+	vma->vm_flags |= VM_IO | VM_PFNMAP;
+	// optimization such as wc seem unnecessary, bottlenecks are elsewhere
+	vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+
+	if (remap_pfn_range(vma, userspace_addr, (unsigned long)gdr.cmem_env_phys >> PAGE_SHIFT, 
+				CPU_PAGE_SIZE, vma->vm_page_prot))
+		return -EAGAIN;
+	userspace_addr += CPU_PAGE_SIZE;
+
+	for (i = 0; i < num_slots; i += slots_per_page,
+		userspace_addr += CPU_PAGE_SIZE) {
+		if (remap_pfn_range(vma, userspace_addr, 
+					(unsigned long)gdr.phys_map_redirect_ring[i] >> PAGE_SHIFT,
+					CPU_PAGE_SIZE, vma->vm_page_prot))
+			return -EAGAIN;
+	}
+
+	return 0;
+}
+
