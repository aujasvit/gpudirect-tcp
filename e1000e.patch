+void gpu_page_table_free_callback(void* page_table) 
+{
+	// not really sure when is this called or what to do here. Should gdr be stopped, then reset e1000e? Probably.
+	// Does it really matter? Also probably no.
+	pr_alert("nvidia_p2p_get_pages free_callback invoked! when is this? add logic, see code!\n");
+
+	nvidia_p2p_free_page_table((nvidia_p2p_page_table_t*)page_table);
+}
