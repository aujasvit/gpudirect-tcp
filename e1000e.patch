+static ssize_t chdev_setup_write(struct file* filp, const char* buff, size_t len,
+		loff_t* off)
+{
+	gdr_mem_setup_t mem_setup;
+	if (gdr.enabled) {
+		return -EINVAL;
+	}
+	if (len != sizeof(mem_setup))
+		return -EINVAL;
+
+	if (copy_from_user(&mem_setup, buff, len))
+		return -EINVAL;
+	if (mem_setup.magic != GDR_MAGIC)
+		return -EINVAL;
+
+	if (enable_gdr(mem_setup) < 0)
+		return -EINVAL;
+
+	pr_info("chdev write successful\n");
+	return len;
+}
+
+static ssize_t chdev_inject_write(struct file* filp, const char* buff, size_t len,
+		loff_t* off)
+{
+	if (!gdr.enabled) 
+		return -EINVAL;
+	if (len != 1)
+		return -EINVAL;
+	//napi_schedule(&gdr.adapter->napi);
+	return len;
+}
+
+static ssize_t chdev_inject_read(struct file* filp, char* ubuf, size_t length, loff_t* offset)
+{
+    if (length != 0)
+	return -EINVAL;
+
+    wait_event_interruptible(gdr.userspace_wq, (atomic_read(&gdr.wake_up_userspace) == 1));
+    atomic_set(&gdr.wake_up_userspace, 0);
+
+    return length;
+}
